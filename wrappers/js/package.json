{
  "name": "quantion",
  "version": "0.2.4",
  "description": "Read Ionic (.ion) and mzML files and turn chromatograms into numbers: noise, baseline, peaks, targets and features.",
  "homepage": "https://phenological.github.io/quantion/?language=js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phenological/quantion.git",
    "directory": "wrappers/js"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index-node.js",
  "types": "./lib/index-node.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index-wasm.d.ts",
        "default": "./dist/quantion.js"
      },
      "require": {
        "types": "./lib/index-node.d.ts",
        "default": "./lib/index-node.js"
      },
      "default": {
        "types": "./lib/index-node.d.ts",
        "default": "./lib/index-node.js"
      }
    }
  },
  "files": [
    "dist/**",
    "!dist/quantion.wasm",
    "lib/**",
    "native/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist lib types",
    "check-types": "tsc --noEmit",
    "eslint": "eslint src --cache",
    "eslint-fix": "npm run eslint -- --fix",
    "prettier-write": "prettier --write src",
    "prepack": "npm run clean && npm run build && npm run tsc-cjs && node scripts/stage-native.mjs",
    "postpack": "node scripts/stage-native.mjs --clean",
    "build": "webpack --config webpack.config.cjs && tsc --project tsconfig.esm.json",
    "tsc-cjs": "tsc --project tsconfig.cjs.json && node -e \"const fs=require('fs');fs.mkdirSync('lib',{recursive:true});fs.writeFileSync('lib/package.json','{\\n  \\\"type\\\": \\\"commonjs\\\"\\n}\\n')\"",
    "prettier": "prettier --check src",
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "dependencies": {
    "ml-spectra-processing": "14.29.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "jest": "^30.4.2",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^12.4.0",
    "prettier": "^3.10.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
